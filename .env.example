# ==========================================
# AEGIS Backend & Server Configuration
# ==========================================
AEGIS_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ==========================================
# Agent Telemetry Ingestion Authentication
# ==========================================
AGENT_INGEST_TOKEN=your_secure_agent_ingest_token_here

# ==========================================
# Supabase PostgreSQL Server-Side Access
# ==========================================
# Project Ref: hiwfbmwgnpnwaszltqwb (AEGIS-dev)
SUPABASE_URL=https://hiwfbmwgnpnwaszltqwb.supabase.co
# CRITICAL: Keep SUPABASE_SERVICE_ROLE_KEY strictly server-side. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==========================================
# 3-Key AI Role Allocation Architecture
# ==========================================
# Options for AEGIS_LLM_PROVIDER: "mock", "gemini", "openai"
AEGIS_LLM_PROVIDER=gemini
AEGIS_LLM_MODEL=gemini-2.5-flash
AEGIS_LLM_TIMEOUT=30

# Dedicated Key Slot 1: RM Analysis & Incident Investigation Agent
AEGIS1=your_gemini_api_key_slot_1_here
# Dedicated Key Slot 2: SC Security Posture Analysis Agent (CIS + DISA STIG)
AEGIS2=your_gemini_api_key_slot_2_here
# Dedicated Key Slot 3: Daily & Incident Reporting Agent
AEGIS3=your_gemini_api_key_slot_3_here

# Fallback single key (used if AEGIS1/2/3 are not set individually)
AEGIS_LLM_API_KEY=your_gemini_api_key_here
