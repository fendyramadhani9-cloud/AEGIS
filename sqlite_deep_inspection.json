      "timeline_json": "[{\"step\": 1, \"timestamp\": \"2026-11-07T16:05:00+00:00\", \"event_type\": \"auth_failure\", \"description\": \"Brute-force SSH attempts begin from 198.51.100.61 against user root.\", \"evidence_id\": \"EVT-host-fenn-ubuntu-AUTH-FAIL-89651\"}, {\"step\": 2, \"timestamp\": \"2026-11-07T16:10:01+00:00\", \"event_type\": \"auth_failure\", \"description\": \"Authentication failures observed for user_419 and user_472.\", \"evidence_id\": \"EVT-host-fenn-ubuntu-AUTH-FAIL-40419\"}, {\"step\": 3, \"timestamp\": \"2026-11-07T16:10:45+00:00\", \"event_type\": \"auth_success\", \"description\": \"Successful SSH login for user_419 and user_472.\", \"evidence_id\": \"EVT-host-fenn-ubuntu-AUTH-SUCCESS-40421\"}, {\"step\": 4, \"timestamp\": \"2026-11-07T16:20:00+00:00\", \"event_type\": \"sudo_execution\", \"description\": \"User ubuntu executes interactive root shell (/bin/bash) via sudo.\", \"evidence_id\": \"EVT-host-fenn-ubuntu-SUDO-EXEC-62572\"}, {\"step\": 5, \"timestamp\": \"2026-11-07T16:21:00+00:00\", \"event_type\": \"sudo_execution\", \"description\": \"User ubuntu modifies web directory permissions via sudo (/bin/chmod 777 /var/www/html).\", \"evidence_id\": \"EVT-host-fenn-ubuntu-SUDO-EXEC-62582\"}, {\"step\": 6, \"timestamp\": \"2026-11-07T16:30:00+00:00\", \"event_type\": \"sudo_execution\", \"description\": \"User ubuntu executes another interactive root shell via sudo.\", \"evidence_id\": \"EVT-host-fenn-ubuntu-SUDO-EXEC-15914\"}]",
